SERVICE_JWT_SECRET=change-me-in-every-environment
SERVICE_JWT_ALGORITHM=HS256
SUPPORTED_LANGUAGES=en,ar
STT_MAX_AUDIO_BYTES=26214400
STT_ALLOWED_CONTENT_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/mp4,audio/m4a,audio/webm,audio/ogg,audio/flac

# Speech-to-text model serving. "stub" needs nothing installed; "faster_whisper" needs
# `uv sync --extra stt` and a model available locally or downloadable.
STT_BACKEND=stub
STT_MODEL=large-v3-turbo
STT_DEVICE=auto
STT_COMPUTE_TYPE=default
STT_TIMEOUT_SECONDS=120
# Set both of these in an air-gapped environment, with the model staged under the root.
STT_LOCAL_FILES_ONLY=false
# STT_DOWNLOAD_ROOT=/models/faster-whisper
